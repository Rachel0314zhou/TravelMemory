<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Left Accent colored circle or label -->
        <TextView
            android:id="@+id/tv_expense_category_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="餐饮"
            android:textSize="11sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:background="@drawable/card_rounded_white"
            android:backgroundTint="@color/cat_food"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/tv_expense_category_tag"
            android:layout_marginStart="12dp"
            android:layout_toStartOf="@+id/tv_expense_amount"
            android:layout_marginEnd="10dp"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tv_expense_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="曾厝垵大排档"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_expense_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-06-01"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Delete button -->
        <ImageButton
            android:id="@+id/btn_delete_expense"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/text_secondary"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="删除" />

        <!-- Bold Amount -->
        <TextView
            android:id="@+id/tv_expense_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥168.5"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:layout_toStartOf="@id/btn_delete_expense"
            android:layout_marginEnd="12dp"
            android:layout_centerVertical="true" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
