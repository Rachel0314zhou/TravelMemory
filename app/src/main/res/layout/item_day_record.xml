<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">

    <!-- Timeline left lines and dots framework -->
    <!-- The vertical line -->
    <View
        android:id="@+id/timeline_vertical_line"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:background="@color/divider"
        android:layout_alignTop="@+id/timeline_dot"
        android:layout_alignBottom="@+id/timeline_card_container" />

    <!-- The timeline dot -->
    <View
        android:id="@+id/timeline_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="11dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_timeline_dot" />

    <!-- Content Card -->
    <LinearLayout
        android:id="@+id/timeline_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/timeline_dot"
        android:layout_marginStart="20dp"
        android:layout_marginVertical="7dp"
        android:background="@drawable/card_rounded_white"
        android:elevation="2dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="14dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Title Date -->
            <TextView
                android:id="@+id/tv_record_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-06-01"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_alignParentStart="true" />

            <!-- Mood Badge -->
            <TextView
                android:id="@+id/tv_record_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开心 😊"
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:background="@drawable/tag_warning"
                android:backgroundTint="@color/mood_happy"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <!-- Brief note text -->
        <TextView
            android:id="@+id/tv_record_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="第一天到达厦门，海风很舒服..."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="3sp" />

    </LinearLayout>

</RelativeLayout>
