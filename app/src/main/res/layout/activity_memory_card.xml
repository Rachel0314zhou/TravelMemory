<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_card_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/abc_ic_ab_back_material"
            app:tint="@color/white"
            android:contentDescription="返回" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/memory_card_title"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- CAPTURE CONTAINER: This is the design we render onto canvas for sharing -->
            <LinearLayout
                android:id="@+id/layout_capture_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_rounded_white"
                android:elevation="4dp"
                android:layout_margin="4dp"
                android:paddingBottom="20dp"
                android:clipToPadding="false">

                <!-- 1. Postcard Top Image -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp">

                    <ImageView
                        android:id="@+id/iv_card_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/travel_placeholder"
                        android:contentDescription="时光封面" />

                    <!-- Bottom fade overlay -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_alignParentBottom="true"
                        android:background="#D0000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="12dp"
                        android:text="“旅迹纪念”"
                        android:textColor="@color/white"
                        android:textSize="11dp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_primary"
                        android:backgroundTint="@color/accent"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />

                    <!-- Overlaid labels -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="12dp">

                        <TextView
                            android:id="@+id/tv_card_trip_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="毕业前的厦门之旅"
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:textStyle="bold" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/tv_card_dates_dest"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📍 厦门 · 2026-06-01 ~ 06-04"
                                android:textSize="11sp"
                                android:textColor="@color/primary_light" />

                            <TextView
                                android:id="@+id/tv_card_days"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="共度 4 天"
                                android:textSize="11sp"
                                android:textColor="@color/white"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </LinearLayout>

                </RelativeLayout>

                <!-- 2. Statistic Overview Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✦ 旅行数据回顾"
                        android:textSize="12sp"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- Stat 2x2 Grid -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="3"
                        android:alignmentMode="alignMargins"
                        android:columnOrderPreserved="false">

                        <!-- Photo count -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📷 记录照片: " android:textSize="12sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_card_stat_photos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 张" android:textSize="12sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <!-- Spot count -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍 景点打卡: " android:textSize="12sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_card_stat_spots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 个" android:textSize="12sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <!-- Expense -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💰 累计花费: " android:textSize="12sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_card_stat_expenses" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¥0.0" android:textSize="12sp" android:textColor="@color/accent" android:textStyle="bold" android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <!-- Mood -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✨ 最常心情: " android:textSize="12sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_card_stat_mood" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开心 😊" android:textSize="12sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <!-- Best spot -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_columnSpan="2"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌟 心动景点: " android:textSize="12sp" android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_card_stat_best_spot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="暂无最爱" android:textSize="12sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginStart="4dp"/>
                        </LinearLayout>

                    </GridLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="14dp" />

                <!-- 3. Longest note display (精选笔记) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✦ 旅途精选笔记"
                        android:textSize="12sp"
                        android:textColor="@color/primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_card_longest_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="“第一天到达厦门，海风很舒服，傍晚去了沙坡尾...”"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/black"
                        android:background="@drawable/card_rounded_white"
                        android:backgroundTint="@color/bg_light"
                        android:padding="12dp"
                        android:fontStyle="italic" />
                </LinearLayout>

                <!-- 4. Easter Egg Section (彩蛋文案) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_card_easter_egg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="打卡达人！这趟旅行被你走成了地图上的星光。"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent"
                        android:gravity="center"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—— 旅迹本 · 收藏当时的自己 ——"
                        android:textSize="10sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 5. Interactive Share Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btn_share_postcard"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_primary"
                    android:backgroundTint="@color/accent"
                    android:text="🔗 生成分享图片"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_save_postcard_local"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_primary"
                    android:backgroundTint="@color/primary"
                    android:text="💾 存至缓存"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
