<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_card_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:src="@drawable/abc_ic_ab_back_material"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="回忆卡片"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bg_light"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tab_memory_card"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:gravity="center"
            android:text="回忆卡片"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_travel_album"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_secondary"
            android:gravity="center"
            android:text="旅行相册"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_memory_album_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="@drawable/card_rounded_white"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="旅行相册"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_memory_album_empty"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:gravity="center"
                    android:text="当前旅行还没有添加照片。"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />

                <GridLayout
                    android:id="@+id/grid_memory_album"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:columnOrderPreserved="false"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_capture_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:background="@drawable/card_rounded_white"
                android:clipToPadding="false"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="190dp">

                    <ImageView
                        android:id="@+id/iv_card_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="回忆卡片封面"
                        android:scaleType="centerCrop"
                        android:src="@drawable/travel_placeholder" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:layout_alignParentBottom="true"
                        android:background="#D0000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="12dp"
                        android:background="@drawable/btn_primary"
                        android:backgroundTint="@color/accent"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="旅迹本纪念"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_card_trip_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="毕业前的厦门之旅"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/tv_card_dates_dest"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="厦门 | 2026-06-01 ~ 2026-06-04"
                                android:textColor="@color/primary_light"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tv_card_days"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="共度 4 天"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </LinearLayout>
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="旅行数据回顾"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alignmentMode="alignMargins"
                        android:columnCount="2"
                        android:columnOrderPreserved="false">

                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="照片：" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_card_stat_photos" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="0 张" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="打卡：" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_card_stat_spots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="0 个" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="花费：" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_card_stat_expenses" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="¥0.00" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="心情：" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_card_stat_mood" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="暂无记录" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="最爱打卡：" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_card_stat_best_spot" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="暂无最爱" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="计划完成率：" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_card_plan_rate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="0%" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="遗憾数量：" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_card_regret_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="0 个" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="打包完成率：" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_card_packing_rate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:paddingVertical="4dp" android:text="0%" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                    </GridLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="旅途精选笔记"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_card_longest_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_rounded_white"
                        android:backgroundTint="@color/bg_light"
                        android:lineSpacingExtra="3dp"
                        android:padding="12dp"
                        android:text="“第一天到达厦门，海风很舒服。”"
                        android:textColor="@color/black"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_card_regret_top3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/card_rounded_white"
                        android:backgroundTint="@color/bg_light"
                        android:padding="12dp"
                        android:text="没有留下明显遗憾"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_card_easter_egg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="每一次出发，都会变成独一无二的回忆。"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:text="旅迹本 TravelMemory | 收藏当时的自己"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_memory_card_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_save_postcard_local"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:backgroundTint="@color/primary"
                    android:text="生成图片"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_share_postcard"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:backgroundTint="@color/accent"
                    android:text="分享回忆"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
