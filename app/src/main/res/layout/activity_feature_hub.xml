<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btn_feature_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="&#x8FD4;&#x56DE;"
            android:src="@drawable/abc_ic_ab_back_material"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="&#x529F;&#x80FD;&#x6269;&#x5C55;"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="&#x4E3A;&#x540E;&#x7EED;&#x8BFE;&#x5802;&#x5C55;&#x793A;&#x548C;&#x4F5C;&#x54C1;&#x6269;&#x5C55;&#x9884;&#x7559;&#x7684;&#x672C;&#x5730;&#x529F;&#x80FD;&#x5165;&#x53E3;"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/feature_achievement"
                style="@style/FeatureEntryText"
                android:text="&#x65C5;&#x884C;&#x6210;&#x5C31;&#x7CFB;&#x7EDF;" />

            <TextView
                android:id="@+id/feature_mood_report"
                style="@style/FeatureEntryText"
                android:text="&#x65C5;&#x884C;&#x5FC3;&#x60C5;&#x7EDF;&#x8BA1;" />

            <TextView
                android:id="@+id/feature_year_report"
                style="@style/FeatureEntryText"
                android:text="&#x5E74;&#x5EA6;&#x65C5;&#x884C;&#x62A5;&#x544A;" />

            <TextView
                android:id="@+id/feature_packing"
                style="@style/FeatureEntryText"
                android:text="&#x884C;&#x674E;&#x6E05;&#x5355;" />

            <TextView
                android:id="@+id/feature_inspiration"
                style="@style/FeatureEntryText"
                android:text="&#x65C5;&#x884C;&#x7075;&#x611F;&#x6536;&#x85CF;" />

            <TextView
                android:id="@+id/feature_export"
                style="@style/FeatureEntryText"
                android:text="&#x6570;&#x636E;&#x5BFC;&#x51FA;" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
