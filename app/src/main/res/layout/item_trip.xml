<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1.2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Trip Cover image -->
        <ImageView
            android:id="@+id/iv_trip_cover"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:src="@drawable/travel_placeholder"
            android:contentDescription="旅行封面" />

        <!-- Info container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_trip_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="毕业前的厦门之旅"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <!-- Destination label -->
                <TextView
                    android:id="@+id/tv_trip_destination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 厦门"
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true" />

                <!-- Days count label in bubble -->
                <TextView
                    android:id="@+id/tv_trip_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 天"
                    android:textSize="11sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:background="@drawable/card_rounded_white"
                    android:backgroundTint="@color/primary_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <!-- Date Range -->
            <TextView
                android:id="@+id/tv_trip_dates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2026-06-01 ~ 2026-06-04"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
