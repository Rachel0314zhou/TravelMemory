<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_spot_type_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="景点"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:background="@drawable/card_rounded_white"
            android:backgroundTint="@color/primary_light"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true" />

        <TextView
            android:id="@+id/tv_spot_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="日光岩"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_toEndOf="@id/tv_spot_type_tag"
            android:layout_marginStart="8dp"
            android:layout_alignBaseline="@id/tv_spot_type_tag" />

        <!-- Favorite button (Star) -->
        <ImageButton
            android:id="@+id/btn_spot_toggle_favorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/btn_star_big_off"
            android:layout_toStartOf="@+id/btn_delete_spot"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:contentDescription="Toggle Favorite" />

        <!-- Delete button -->
        <ImageButton
            android:id="@+id/btn_delete_spot"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/text_secondary"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="删除" />

        <!-- Review Note -->
        <TextView
            android:id="@+id/tv_spot_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="爬上去可以看到整个洋房和沙滩，非常宏大！"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_below="@id/tv_spot_type_tag"
            android:layout_marginTop="8dp"
            android:layout_toStartOf="@id/btn_spot_toggle_favorite"
            android:layout_marginEnd="12dp" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
